# ---------------------------------------------------------------------------
# Server configuration - copy this file to  server/.env  and edit the values.
#   cp server/.env.example server/.env
# ---------------------------------------------------------------------------

# Port the Express API listens on (the React client is proxied to it)
PORT=5000
NODE_ENV=development

# Public URL of the React app - used for links inside notification emails
CLIENT_URL=http://localhost:5173

# ------------------------------- DATABASE ---------------------------------
# mongo  -> always use MongoDB (fails to start if it is unreachable)
# memory -> use the built-in JSON-file dev store (no MongoDB required)
# auto   -> try MongoDB first, fall back to the dev store        [default]
DB_MODE=auto

# Local MongoDB. Open MongoDB Compass and connect to  mongodb://127.0.0.1:27017
# The application creates the  scholarship_portal  database automatically.
MONGODB_URI=mongodb://127.0.0.1:27017/scholarship_portal

# Used only by the "memory" backend
# MEMORY_DATA_FILE=./.data/memory-db.json

# --------------------------- AUTHENTICATION -------------------------------
# CHANGE THIS before deploying anywhere public
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ------------------------------ UPLOADS -----------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# -------------------------- EMAIL NOTIFICATIONS ---------------------------
# Leave SMTP_HOST empty to run in "Email Outbox" mode: every notification email
# is stored in the database and can be previewed under Admin > Email Outbox.
# Fill these in to deliver mail for real (Gmail, Zoho, SES, Mailgun, ...).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Scholarship Foundation <no-reply@scholarshipfoundation.org>

# --------------------------- ORGANISATION ---------------------------------
# Shown across the website, emails and PDF-ready views
ORG_NAME=Scholarship Foundation
ORG_SHORT_NAME=SF
ORG_TAGLINE=Empowering Students. Shaping Futures.
ORG_EMAIL=info@scholarshipfoundation.org
ORG_PHONE=+94 11 234 5678
ORG_ADDRESS=42, Foundation Road, Colombo 07, Sri Lanka

# --------------------- SEED / DEMO ADMIN CREDENTIALS ----------------------
# npm run seed creates these accounts (and the demo students below)
SEED_ADMIN_EMAIL=admin@scholarship.org
SEED_ADMIN_PASSWORD=Admin@123
SEED_STUDENT_EMAIL=student@example.com
SEED_STUDENT_PASSWORD=Student@123
